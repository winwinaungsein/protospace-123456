<div class="contents row">
  <div class="container">
    <h2 class="page-heading">ユーザー新規登録</h2>
    <%= form_with model: @user, url: user_registration_path, id: 'new_user', class: 'new_user', local: true do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      
      <div class="field">
        <%= f.label :name %><br />
        <%= f.text_field :name %>
        </div>

      <div class="field">
        <%= f.label :profile %><br />
        <%= f.text_area :profile %>
      </div>

      <div class="field">
        <%= f.label :occupation %><br />
        <%= f.text_field :occupation %>
      </div>

      <div class="field">
        <%= f.label :position %><br />
        <%= f.text_field :position %>
      </div>

      <div class="field">
        <%= f.label :email, "メールアドレス" %><br />
        <%= f.email_field :email, class: "form_text" %>
      </div>

      <div class="field">
        <%= f.label :password,"パスワード（6文字以上）" %>
        <% if @minimum_password_length %>
          <em>(<%= @minimum_password_length %> characters minimum)</em>
        <% end %><br />
        <%= f.password_field :password, autocomplete: "off", class: "form_text" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "パスワード（確認用）" %><br />
        <%= f.password_field :password_confirmation, autocomplete: "off", class: "form_text" %>
      </div>

      <div class="actions">
        <%= f.submit "新規登録", class: "form__btn" %>
      </div>
    <% end %>
  </div>
</div>