<main class="main">
  <div class="inner">
    <% if user_signed_in? %>
      <div class="greeting">
      こんにちは、
      <%= current_user.name %>
      さん
    </div>
    <% end %>
    <div class="card__wrapper">
      <% @prototypes.each do |prototype| %>
       <%= render "prototype", prototype: prototype %>
       <% end%>
    </div>
  </div>
</main>
